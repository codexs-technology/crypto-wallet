# Flash Crypto Wallet Environment Variables
# Copy this file to .env and fill in your values

# Private key for deployment (NEVER commit real keys)
PRIVATE_KEY=

# RPC URLs
POLYGON_RPC=https://polygon-rpc.com
ETH_RPC=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
BSC_RPC=https://bsc-dataseed.binance.org
TRON_RPC=https://api.trongrid.org

# Infura/Project API keys
INFURA_PROJECT_ID=
ALCHEMY_API_KEY=

# Exchange API keys (for swap/trade functionality)
BINANCE_API_KEY=
BINANCE_API_SECRET=
BITGET_API_KEY=
BITGET_API_SECRET=
MEXC_API_KEY=
MEXC_API_SECRET=
BYBIT_API_KEY=
BYBIT_API_SECRET=

# 1inch API for swaps (aggregates DEXes)
ONEINCH_API_KEY=

# DEX Screener / TradingView API
TRADINGVIEW_API_KEY=
